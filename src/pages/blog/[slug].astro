---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import JsonLd from '../../components/JsonLd.astro';
import { SITE, whatsappHref } from '../../consts';
import { serviceBySlug } from '../../data/services';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { Content, headings } = await post.render();

const all = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const related = all.filter((p) => p.slug !== post.slug).slice(0, 3);

const service = serviceBySlug[post.data.relatedService.replace('/', '')];

const published = post.data.publishedAt;
const modified = post.data.updatedAt ?? post.data.publishedAt;
const fmt = (d: Date) =>
  d.toLocaleDateString('pt-BR', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });

const toc = headings.filter((h) => h.depth === 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: published.toISOString(),
  dateModified: modified.toISOString(),
  author: { '@type': 'Person', name: post.data.author },
  publisher: { '@id': `${SITE.url}/#org` },
  mainEntityOfPage: `${SITE.url}/blog/${post.slug}`,
  image: `${SITE.url}${SITE.ogImage}`,
  inLanguage: 'pt-BR',
  keywords: post.data.targetKeyword,
};
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={`/blog/${post.slug}`}
  ogType="article"
  publishedTime={published.toISOString()}
  modifiedTime={modified.toISOString()}
>
  <Breadcrumbs
    items={[{ label: 'Blog', href: '/blog' }, { label: post.data.category }]}
  />

  <div class="mx-auto max-w-wrap px-6 pb-10 pt-8 md:pl-[88px] md:pr-10">
    <p class="ref text-mare">{post.data.category}</p>
    <h1 class="mt-3 max-w-[24ch] text-[34px] font-extrabold leading-[1.1] md:text-[46px]">
      {post.data.title}
    </h1>
    <p class="mt-5 flex flex-wrap gap-x-6 gap-y-1 font-mono text-[13px] uppercase tracking-ref text-concreto">
      <span>{fmt(published)}</span>
      <span>{post.data.readingMinutes} min de leitura</span>
      <span>por {post.data.author}</span>
    </p>
  </div>

  <div
    class="mx-auto grid max-w-wrap gap-16 px-6 pb-16 md:grid-cols-[220px_1fr] md:pl-[88px] md:pr-10"
  >
    {
      toc.length > 1 && (
        <aside class="hidden md:block">
          <nav aria-label="Sumário" class="sticky top-24">
            <p class="ref border-b border-linha-forte pb-2 text-tinta">Sumário</p>
            <ul>
              {toc.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    class="block border-b border-linha py-2 text-[14px] text-concreto hover:text-mare"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }

    <div>
      <article class="prose">
        <Content />
      </article>

      <!-- CTA discreto para o serviço relacionado -->
      <aside
        class="mt-12 flex flex-col gap-4 border border-linha bg-papel p-6 sm:flex-row sm:items-center"
      >
        <span class="text-mare"><Icon name="arrow-right" size={26} /></span>
        <div class="flex-1">
          <p class="text-[15px] font-semibold">{service.h1}</p>
          <p class="mt-1 text-[14px] text-concreto">{service.metaDescription}</p>
        </div>
        <a
          href={service.slug === '' ? '/' : `/${service.slug}`}
          class="inline-flex shrink-0 items-center gap-1.5 font-semibold"
        >
          Ver o serviço <Icon name="arrow-right" size={18} />
        </a>
      </aside>
    </div>
  </div>

  <!-- RELACIONADOS -->
  <div class="border-t border-linha-forte bg-areia">
    <div class="mx-auto max-w-wrap px-6 py-14 md:pl-[88px] md:pr-10">
      <p class="ref text-mare">Continue lendo</p>
      <div class="mt-6 grid gap-px border border-linha bg-linha md:grid-cols-3">
        {
          related.map((p) => (
            <a href={`/blog/${p.slug}`} class="bg-papel p-7 hover:bg-bruma">
              <p class="ref">{p.data.category}</p>
              <h2 class="mt-2.5 text-[18px] font-bold text-tinta">{p.data.title}</h2>
            </a>
          ))
        }
      </div>
      <div class="mt-10">
        <Button href={whatsappHref} icon="whatsapp" external>Falar com a Splash no WhatsApp</Button>
      </div>
    </div>
  </div>

  <JsonLd data={jsonLd} />
</BaseLayout>
