---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';

const title = 'Blog da Splash Sistemas: sites, SEO e sistemas';
const description =
  'Textos diretos sobre criação de sites, SEO, performance e sistemas sob medida. Sem jargão de agência.';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const categories = [...new Set(posts.map((p) => p.data.category))];

const fmt = (d: Date) =>
  d.toLocaleDateString('pt-BR', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });

const [featured, ...rest] = posts;
---
<BaseLayout title={title} description={description} path="/blog">
  <Breadcrumbs items={[{ label: 'Blog' }]} />

  <div class="mx-auto max-w-wrap px-6 pb-10 pt-8 md:pl-[88px] md:pr-10">
    <p class="ref mb-4 text-mare">Notas do estúdio</p>
    <h1 class="max-w-[20ch] text-[36px] font-extrabold leading-[1.06] md:text-[52px]">
      Notas do estúdio sobre sites, performance e sistemas
    </h1>
    <p class="mt-5 max-w-[60ch] text-[19px] text-concreto">
      Textos curtos e diretos sobre SEO, criação de sites, landing pages e sistemas internos. Sem
      jargão de agência.
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-4">
      <form
        action="https://www.google.com/search"
        method="get"
        role="search"
        class="flex max-w-[420px] flex-1 items-center gap-2.5 border border-linha bg-papel px-4 py-3"
      >
        <label class="sr-only" for="busca">Buscar no blog</label>
        <span class="text-concreto"><Icon name="search" size={20} /></span>
        <input
          id="busca"
          name="q"
          type="search"
          placeholder="Buscar por assunto…"
          class="w-full bg-transparent text-[15px] text-tinta outline-none placeholder:text-concreto"
        />
        <input type="hidden" name="as_sitesearch" value="splashsistemas.com.br" />
      </form>
      <span class="ref">{posts.length} artigos</span>
    </div>

    <ul class="mt-5 flex flex-wrap gap-2.5">
      <li class="ref border border-mare px-3.5 py-2 text-mare">Todos</li>
      {
        categories.map((c) => (
          <li class="ref border border-linha px-3.5 py-2">{c}</li>
        ))
      }
    </ul>
  </div>

  <!-- DESTAQUE -->
  <div class="mx-auto max-w-wrap px-6 pb-11 md:pl-[88px] md:pr-10">
    <a
      href={`/blog/${featured.slug}`}
      class="grid border border-linha bg-papel md:grid-cols-2"
    >
      <div class="flex min-h-[280px] items-end bg-bruma p-6">
        <span class="ref">{featured.data.category}</span>
      </div>
      <div class="flex flex-col justify-center p-8 md:p-10">
        <p class="ref text-mare">
          {featured.data.category} · {fmt(featured.data.publishedAt)} · {featured.data.readingMinutes} min
        </p>
        <h2 class="mt-3.5 text-[26px] font-bold leading-[1.15] md:text-[30px]">
          {featured.data.title}
        </h2>
        <p class="mt-3.5 text-[15.5px] text-concreto">{featured.data.description}</p>
        <span class="mt-5 inline-flex items-center gap-2 font-semibold">
          Ler artigo <Icon name="arrow-right" size={20} />
        </span>
      </div>
    </a>
  </div>

  <!-- LISTA -->
  <div class="mx-auto max-w-wrap px-6 pb-24 md:pl-[88px] md:pr-10">
    <ul class="border-t border-linha-forte">
      {
        rest.map((p) => (
          <li>
            <a
              href={`/blog/${p.slug}`}
              class="grid gap-2 border-b border-linha py-7 md:grid-cols-[170px_1fr_120px] md:gap-8"
            >
              <span class="ref">{p.data.category}</span>
              <div>
                <h2 class="text-[20px] font-bold text-tinta">{p.data.title}</h2>
                <p class="mt-1.5 text-[15px] text-concreto">{p.data.description}</p>
              </div>
              <span class="ref md:text-right">
                {fmt(p.data.publishedAt)} · {p.data.readingMinutes} min
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
