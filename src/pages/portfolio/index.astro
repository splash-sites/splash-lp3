---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { portfolio } from '../../data/portfolio';
import { CONTACT } from '../../consts';

const title = 'Portfólio de sites e sistemas | Splash Sistemas';
const description =
  'Projetos de criação de sites, landing pages e sistemas sob medida feitos pela Splash. Cases reais em breve.';
---
<BaseLayout title={title} description={description} path="/portfolio">
  <Breadcrumbs items={[{ label: 'Portfólio' }]} />

  <div class="mx-auto max-w-wrap px-6 pb-12 pt-8 md:pl-[88px] md:pr-10">
    <p class="ref mb-4 text-mare">Trabalhos da Splash</p>
    <h1 class="max-w-[20ch] text-[36px] font-extrabold leading-[1.06] md:text-[52px]">
      Projetos de sites e sistemas feitos pela Splash
    </h1>
    <p class="mt-5 max-w-[60ch] text-[19px] text-concreto">
      Três projetos, um por faixa de plano. O estudo de caso detalhado de cada um está sendo
      escrito.
    </p>
  </div>

  <div class="mx-auto max-w-wrap px-6 pb-24 md:pl-[88px] md:pr-10">
    <div class="grid gap-px border border-linha bg-linha md:grid-cols-3">
      {
        portfolio.map((c) => (
          <a href={`/portfolio/${c.slug}`} class="group bg-papel transition-colors hover:bg-bruma">
            <div class="border-b border-linha">
              <Image
                src={c.cover}
                alt={c.coverAlt}
                width={520}
                height={390}
                loading="lazy"
                class="aspect-[4/3] w-full object-cover object-top"
              />
            </div>
            <div class="p-6">
              <p class="ref">Plano {c.plan} · {c.service}</p>
              <h2 class="mt-2 text-[18px] font-bold text-tinta">{c.title}</h2>
              <p class="mt-2 text-[14.5px] text-concreto">{c.summary}</p>
              <span class="mt-4 inline-flex items-center gap-2 text-[14px] font-semibold text-mare">
                Ver projeto <Icon name="arrow-right" size={16} />
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-10 flex items-start gap-5 border border-linha bg-papel p-7">
      <span class="text-concreto"><Icon name="search" size={22} /></span>
      <div>
        <p class="ref">Avaliações no Google</p>
        <p class="mt-2 max-w-[70ch]">
          O que os clientes dizem sobre a Splash está no perfil da empresa no Google.
        </p>
        <a
          href={CONTACT.googleReviewsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-2 font-semibold"
        >
          Ver avaliações no Google <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </div>

  <CtaBand
    title="Seu projeto pode ser o próximo case."
    text="Conta o que a sua empresa precisa. A gente responde com um plano e, se topar, o resultado entra aqui."
  />
</BaseLayout>
