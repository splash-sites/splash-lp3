---
// Ícones de traço, grade de 24px, um estilo só. Nunca emoji.
interface Props {
  name:
    | 'whatsapp'
    | 'arrow-right'
    | 'check'
    | 'x'
    | 'mail'
    | 'instagram'
    | 'clock'
    | 'menu'
    | 'chevron-down'
    | 'browser'
    | 'brackets'
    | 'gauge'
    | 'search';
  size?: number;
  class?: string;
}
const { name, size = 22, class: cls = '' } = Astro.props;
const paths: Record<Props['name'], string> = {
  whatsapp:
    'M12 3a9 9 0 0 0-7.7 13.6L3 21l4.6-1.2A9 9 0 1 0 12 3ZM9.9 8c.4 0 .8.3 1 .7l.6 1.4-1 1c.5 1 1.3 1.8 2.3 2.3l1-1 1.4.6c.4.2.7.6.7 1 0 .8-.7 1.5-1.5 1.5A6 6 0 0 1 8.4 9.5C8.4 8.7 9.1 8 9.9 8Z',
  'arrow-right': 'M5 12h14M13 6l6 6-6 6',
  check: 'M5 13l4 4L19 7',
  x: 'M6 6l12 12M18 6L6 18',
  mail: 'M3 6h18v12H3zM3 7l9 6 9-6',
  instagram: 'M3 3h18v18H3zM12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8ZM17 6.5h.01',
  clock: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM12 7v5l3 2',
  menu: 'M4 7h16M4 12h16M4 17h16',
  'chevron-down': 'M6 9l6 6 6-6',
  browser: 'M3 5h18v14H3zM3 9h18M7 7h.01M10 7h.01',
  brackets: 'M8 8l-4 4 4 4M16 8l4 4-4 4M13 5l-2 14',
  gauge: 'M12 13l4-4M4 18a8 8 0 1 1 16 0',
  search: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14ZM20 20l-4-4',
};
const d = paths[name];
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
><path d={d}></path></svg>
