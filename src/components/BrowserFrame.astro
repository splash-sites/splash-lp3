---
// Moldura de janela de navegador. Os pontos ficam no tom neutro forte
// (não vermelho/amarelo/verde) para não brigar com o acento único do site.
// A barra de URL só aparece quando `domain` é informado.
interface Props {
  domain?: string;
  class?: string;
}
const { domain, class: cls = '' } = Astro.props;
---
<div class={`overflow-hidden border border-linha bg-papel ${cls}`}>
  <div class="flex items-center gap-3 border-b border-linha bg-areia px-3 py-2">
    <span class="flex gap-1.5">
      <span class="h-2 w-2 rounded-full bg-linha-forte"></span>
      <span class="h-2 w-2 rounded-full bg-linha-forte"></span>
      <span class="h-2 w-2 rounded-full bg-linha-forte"></span>
    </span>
    {
      domain && (
        <span class="min-w-0 flex-1 truncate border border-linha bg-papel px-2.5 py-0.5 font-mono text-[11px] text-concreto">
          {domain}
        </span>
      )
    }
  </div>
  <div class="overflow-hidden">
    <slot />
  </div>
</div>
