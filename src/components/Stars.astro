---
// Cinco estrelas cheias. Todas as avaliações da Splash no Google são 5.
interface Props {
  size?: number;
  class?: string;
}
const { size = 16, class: cls = '' } = Astro.props;
---
<span class={`inline-flex gap-0.5 text-mare ${cls}`} role="img" aria-label="5 de 5 estrelas">
  {
    [0, 1, 2, 3, 4].map(() => (
      <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2.5l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 21.3l-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9z" />
      </svg>
    ))
  }
</span>
