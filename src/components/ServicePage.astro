---
import { SITE, CONTACT, whatsappHref } from '../consts';
import type { Service } from '../data/services';
import { getCollection } from 'astro:content';
import Breadcrumbs from './Breadcrumbs.astro';
import Section from './Section.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import Faq from './Faq.astro';
import CtaBand from './CtaBand.astro';
import SplashMark from './SplashMark.astro';
import JsonLd from './JsonLd.astro';

interface Props {
  service: Service;
}
const { service } = Astro.props;

const posts = await getCollection('blog', ({ data }) => !data.draft);
const related = service.relatedPosts
  .map((slug) => posts.find((p) => p.slug === slug))
  .filter((p): p is (typeof posts)[number] => Boolean(p));

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.serviceType,
  serviceType: service.serviceType,
  description: service.metaDescription,
  url: `${SITE.url}/${service.slug}`,
  provider: { '@id': `${SITE.url}/#org` },
  areaServed: CONTACT.areaServed.map((name) => ({ '@type': 'AdministrativeArea', name })),
  audience: { '@type': 'BusinessAudience', name: 'Pequenas e médias empresas' },
};
---
<Breadcrumbs items={[{ label: 'Serviços' }, { label: service.shortLabel }]} />

<!-- HERO -->
<section class="relative overflow-hidden">
  <SplashMark
    variant="hero"
    class="pointer-events-none absolute right-[-80px] top-[-40px] h-[560px] w-[720px] opacity-90"
  />
  <div class="relative mx-auto max-w-wrap px-6 pb-20 pt-14 md:pb-24 md:pl-[88px] md:pr-10">
    <p class="font-mono text-[12px] uppercase tracking-[0.1em] text-mare">{service.kicker}</p>
    <h1 class="mt-5 max-w-[18ch] text-[40px] font-extrabold leading-[1.05] md:text-[58px]">
      {service.h1}
    </h1>
    <p class="mt-6 max-w-[62ch] text-[20px] leading-snug">{service.intro}</p>
    <div class="mt-8 flex flex-col gap-4 sm:flex-row">
      <Button href={whatsappHref} icon="whatsapp" external>Pedir um orçamento no WhatsApp</Button>
      <Button href="#processo" variant="ghost" icon="arrow-right" iconAfter>Ver o processo</Button>
    </div>
  </div>
</section>

<!-- O QUE ESTÁ INCLUSO -->
<Section refLabel="Escopo padrão">
  <h2 class="text-[32px] font-bold leading-[1.12] md:text-[38px]">{service.includedTitle}</h2>
  <p class="mt-4 max-w-[62ch] text-[20px] leading-snug">
    Este é o ponto de partida. O escopo final é escrito junto com você antes de começar.
  </p>
  <div class="mt-10 grid gap-px border border-linha bg-linha sm:grid-cols-2">
    {
      service.included.map((it) => (
        <div class="bg-papel p-8">
          <h3 class="text-[17px] font-bold">{it.label}</h3>
          <p class="mt-2 text-[15px] text-concreto">{it.desc}</p>
        </div>
      ))
    }
  </div>
  {service.includedNote && <p class="ref mt-6">{service.includedNote}</p>}
</Section>

<!-- PROCESSO (sequência real) -->
<Section refLabel={`Processo · ${service.process.length} etapas`} id="processo">
  <h2 class="text-[32px] font-bold leading-[1.12] md:text-[38px]">Como funciona, etapa por etapa</h2>
  <ol class="mt-10">
    {
      service.process.map((step) => (
        <li class="grid gap-4 border-t border-linha py-7 md:grid-cols-[56px_1fr_1fr] md:gap-7">
          <span class="font-mono text-[15px] text-mare">{step.n}</span>
          <div>
            <h3 class="text-[19px] font-bold">{step.title}</h3>
            <p class="mt-2 text-[15px] text-concreto">{step.desc}</p>
          </div>
          <p class="text-[14px] text-concreto">
            <span class="ref">Você entrega:</span> {step.youBring}
          </p>
        </li>
      ))
    }
  </ol>
</Section>

<!-- FAQ -->
<Section refLabel="Perguntas frequentes">
  <Faq items={service.faq} />
</Section>

<!-- RELACIONADOS -->
{
  related.length > 0 && (
    <Section refLabel="Do blog">
      <h2 class="text-[28px] font-bold leading-[1.14] md:text-[32px]">Continue lendo</h2>
      <div class="mt-6 grid gap-px border border-linha bg-linha md:grid-cols-3">
        {related.map((p) => (
          <a href={`/blog/${p.slug}`} class="bg-papel p-7 hover:bg-bruma">
            <p class="ref">{p.data.category}</p>
            <h3 class="mt-2.5 text-[18px] font-bold text-tinta">{p.data.title}</h3>
          </a>
        ))}
      </div>
    </Section>
  )
}

<CtaBand
  title="Conta o que você faz e para quem. O resto a gente puxa na conversa."
  text="A gente responde com um plano do que dá para fazer e em quanto tempo, com escopo e preço fechados antes de começar."
/>

<JsonLd data={serviceSchema} />
